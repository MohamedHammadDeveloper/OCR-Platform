# HuggingFace token — required for legal-documents (Gemma 3 is a gated base model)
HF_TOKEN=

# Shared model storage root: <root>/<model-folder>/<model-name>
OCR_MODEL_ROOT=/workspace/models

# --- arabic-handwritten ---
HANDWRITTEN_HF_REPO_ID=sherif1313/Arabic-English-handwritten-OCR-v3
HANDWRITTEN_PROJECT_NAME=arabic-handwritten
HANDWRITTEN_MODEL_NAME=Arabic-English-handwritten-OCR-v3

# --- legal-documents ---
LEGAL_HF_REPO_ID=bakrianoo/arabic-legal-documents-ocr-1.0
LEGAL_PROJECT_NAME=legal-documents
LEGAL_MODEL_NAME=arabic-legal-documents-ocr-1.0

# legal-documents inference defaults
OCR_DEFAULT_TASK=task_1
OCR_PREPROCESS=true

# Model used when a request omits `model`
OCR_DEFAULT_MODEL=legal-documents

# Server
OCR_HOST=0.0.0.0
OCR_PORT=10100
